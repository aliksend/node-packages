{
  "name": "@aliksend/cache",
  "version": "1.0.4",
  "description": "This module provides cache primitive with some implementations",
  "keywords": [
    "cache"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliksend/node-packages.git",
    "directory": "./packages/cache"
  },
  "license": "MIT",
  "author": "Alik Send",
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./format/*": {
      "default": "./dist/format/*.js",
      "types": "./dist/format/*.d.ts"
    },
    "./storage/*": {
      "default": "./dist/storage/*.js",
      "types": "./dist/storage/*.d.ts"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "lint": "npx @aliksend/linter --fix",
    "prepublishOnly": "npm run build",
    "test": "node --require ts-node/register --test ./src/*.test.ts"
  },
  "dependencies": {
    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "@types/node": "^22.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
